<hbox width="290" height="240" style="spacing: 10px; padding: 10px;">
    <tabview id="tabs" width="100%" height="100%" >
        <!-- <layout type="absolute" /> -->
        
        <vbox text="Animation" style="spacing: 6px;">
            <hbox style="spacing: 6px;">
                <label text="Animation Name:" width="123" />
                <label text="Note Data:" width="123" />
            </hbox>
            
            <hbox style="spacing: 6px;">
                <textfield id="nameInput" width="123" />
                <numberstepper id="noteDataStepper" width="123" min="0" max="999" />
            </hbox>

            <hbox style="spacing: 6px;">
                <label text="Animation Prefix:" width="123" />
                <label text="Indices (optional):" width="123" />
            </hbox>

            <hbox style="spacing: 6px;">
                <textfield id="prefixInput" width="123" />
                <textfield id="indicesInput" width="123" />
            </hbox>

            <hbox style="spacing: 6px;">
                <label text="Min FPS:" width="80" />
                <label text="Max FPS:" width="80" />
                <label text="Animation:" width="80" />
            </hbox>

            <hbox style="spacing: 6px;">
                <numberstepper id="minFps" width="80" min="1" max="120" value="22" />
                <numberstepper id="maxFps" width="80" min="1" max="120" value="26" />
                <dropdown id="animDropDown" width="80" />
            </hbox>

            <button id="addButton" text="Add/Update" />
            <button id="removeButton" text="Remove" />
        </vbox>

        <vbox text="Properties" style="spacing: 6px;">
            <label text="Image:" />
            <hbox style="spacing: 6px;">
                <textfield id="imageInputText" />
                <button id="imageReloadButton" text="Reload Image" />
            </hbox>

            <label text="Note Skin:" />
            <hbox style="spacing: 6px;">
                <textfield id="noteSkinInput" text="NOTE_assets" />
                <button id="noteSkinReloadButton" text="Reload Notes" />
            </hbox>

            <label text="Scale:" />
            <hbox style="spacing: 6px;">
                <numberstepper id="scaleNumericStepper" min="0" max="4" step="0.1" value="1" />
                <checkbox id="allowRGB" text="Allow RGB" />
                <checkbox id="allowPixel" text="Allow Pixel" />
            </hbox>

            <button id="saveButton" text="Save" />
            <button id="templateButton" text="Template" />
        </vbox>

    </tabview>
</hbox>